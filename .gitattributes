# Set default behavior to automatic text conversion with LF line endings.
* text=auto eol=lf

# Explicitly declare text files to always use LF
*.js text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.go text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css text eol=lf
